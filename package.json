    "@hookform/resolvers": "^5.4.3",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.26.0",
    "next": "15.5.21",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.1.0",
