// Roberto Pneus App — Multi-tenant Prisma Schema
// PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
  // Windows: evita lock estranho com engines em alguns AV/IDEs
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  // Pooler (porta 6543 + ?pgbouncer=true) em serverless/Vercel
  url       = env("DATABASE_URL")
  // Conexão direta (porta 5432) — usada por migrate/introspect no Supabase
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MECANICO
  RECEPCIONISTA
}

enum ClientStatus {
  ATIVO
  INATIVO
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum FuelType {
  GASOLINA
  ETANOL
  FLEX
  DIESEL
  GNV
  ELETRICO
  HIBRIDO
  OUTRO
}

enum TransmissionType {
  MANUAL
  AUTOMATICO
  CVT
  AUTOMATIZADO
  OUTRO
}

enum AppointmentStatus {
  AGUARDANDO_APROVACAO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum ServiceOrderStatus {
  ORCAMENTO
  APROVADO
  EM_EXECUCAO
  QUALITY_CHECK
  PRONTO_RETIRADA
  ENTREGUE
  CANCELADO
}

enum PhotoType {
  ANTES
  DEPOIS
  DIAGNOSTICO
  PECA
  OUTRO
}

enum TireType {
  PASSEIO
  SUV
  CAMINHONETE
  CORRIDA
  OFF_ROAD
  COMERCIAL
  MOTO
  OUTRO
}

enum MaintenanceIntervalType {
  KM
  DIAS
  AMBOS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  APP_CHAT
  WHATSAPP
  AI_AGENT
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─────────────────────────────────────────────
// Tenant (Oficina)
// ─────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cnpj      String?
  email     String?
  phone     String?
  whatsapp  String?
  logoUrl   String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      String?
  addressZip        String?
  businessHours     Json?
  paymentMethods    String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  clients            Client[]
  vehicles           Vehicle[]
  appointments       Appointment[]
  serviceOrders      ServiceOrder[]
  tires              Tire[]
  maintenanceTypes   MaintenanceType[]
  maintenancePlans   MaintenancePlan[]
  chatConversations  ChatConversation[]
  whatsappTemplates  WhatsAppTemplate[]
  whatsappLogs       WhatsAppMessageLog[]
  aiConversations    AiConversation[]
  settings           TenantSettings?
  vehicleDocuments   VehicleDocument[]

  @@index([slug])
  @@index([isActive])
  @@map("tenants")
}

model TenantSettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  reminderDaysBefore    Int      @default(7)
  reminderKmBefore      Int      @default(500)
  evolutionApiUrl       String?
  evolutionApiKey       String?
  evolutionInstance     String?
  openaiApiKey          String?
  publicTrackingEnabled Boolean  @default(true)
  timezone              String   @default("America/Sao_Paulo")
  currency              String   @default("BRL")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ─────────────────────────────────────────────
// Users (staff — linked to Supabase Auth)
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String
  authUserId   String    @unique // Supabase Auth UUID
  email        String
  name         String
  phone        String?
  role         Role      @default(RECEPCIONISTA)
  specialty    String?   // especialidade (mecânicos)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedOrders      ServiceOrder[]       @relation("MechanicOrders")
  appointments        Appointment[]        @relation("MechanicAppointments")
  statusChanges       ServiceOrderStatusHistory[]
  chatMessages        ChatMessage[]
  createdOrders       ServiceOrder[]       @relation("CreatedByUser")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([authUserId])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

// ─────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────

model Client {
  id                String       @id @default(cuid())
  tenantId          String
  name              String
  document          String?      // CPF/CNPJ
  whatsapp          String?
  email             String?
  birthDate         DateTime?
  gender            Gender       @default(NAO_INFORMADO)
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      String?
  addressZip        String?
  notes             String?
  status            ClientStatus @default(ATIVO)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  appointments   Appointment[]
  serviceOrders  ServiceOrder[]
  chatConversations ChatConversation[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, document])
  @@index([tenantId, whatsapp])
  @@index([tenantId, email])
  @@index([tenantId, status])
  @@map("clients")
}

// ─────────────────────────────────────────────
// Vehicles
// ─────────────────────────────────────────────

model Vehicle {
  id              String            @id @default(cuid())
  tenantId        String
  clientId        String
  plate           String
  brand           String
  model           String
  yearManufacture Int
  yearModel       Int
  color           String
  currentKm       Int
  chassis         String?
  fuel            FuelType?
  transmission    TransmissionType?
  engine          String?
  power           String?
  engineCode      String?
  notes           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents        VehicleDocument[]
  appointments     Appointment[]
  serviceOrders    ServiceOrder[]
  maintenancePlans MaintenancePlan[]

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, plate])
  @@index([clientId])
  @@map("vehicles")
}

model VehicleDocument {
  id        String   @id @default(cuid())
  tenantId  String
  vehicleId String
  name      String
  fileUrl   String
  fileType  String   // image/jpeg, application/pdf, etc.
  sizeBytes Int?
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_documents")
}

// ─────────────────────────────────────────────
// Appointments
// ─────────────────────────────────────────────

model Appointment {
  id              String            @id @default(cuid())
  tenantId        String
  clientId        String
  vehicleId       String?
  mechanicId      String?
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(CONFIRMADO)
  createdByAi     Boolean           @default(false)
  publicToken     String?           @unique
  notes           String?
  serviceOrderId  String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  mechanic     User?         @relation("MechanicAppointments", fields: [mechanicId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@index([tenantId, mechanicId, startsAt])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("appointments")
}

// ─────────────────────────────────────────────
// Service Orders (Core)
// ─────────────────────────────────────────────

model ServiceOrder {
  id              String             @id @default(cuid())
  tenantId        String
  number          Int                // sequential per tenant
  clientId        String
  vehicleId       String
  mechanicId      String?
  createdById     String?
  status          ServiceOrderStatus @default(ORCAMENTO)
  kmAtEntry       Int
  kmAtExit        Int?
  complaint       String?            // reclamação do cliente
  diagnosis       String?
  internalNotes   String?
  discount        Decimal            @default(0) @db.Decimal(12, 2)
  partsTotal      Decimal            @default(0) @db.Decimal(12, 2)
  laborTotal      Decimal            @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal            @default(0) @db.Decimal(12, 2)
  publicToken     String             @unique @default(cuid())
  estimatedReady  DateTime?
  approvedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle      Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  mechanic     User?                       @relation("MechanicOrders", fields: [mechanicId], references: [id], onDelete: SetNull)
  createdBy    User?                       @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  parts        ServiceOrderPart[]
  laborItems   ServiceOrderLabor[]
  photos       ServiceOrderPhoto[]
  statusHistory ServiceOrderStatusHistory[]
  appointment  Appointment?
  chatConversation ChatConversation?

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, mechanicId])
  @@index([publicToken])
  @@map("service_orders")
}

model ServiceOrderPart {
  id             String   @id @default(cuid())
  serviceOrderId String
  description    String
  brand          String?
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  tireId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  tire         Tire?        @relation(fields: [tireId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@map("service_order_parts")
}

model ServiceOrderLabor {
  id             String   @id @default(cuid())
  serviceOrderId String
  description    String
  hours          Decimal  @default(1) @db.Decimal(10, 2)
  hourlyRate     Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("service_order_labor")
}

model ServiceOrderPhoto {
  id             String    @id @default(cuid())
  serviceOrderId String
  url            String
  caption        String
  type           PhotoType @default(OUTRO)
  storagePath    String?
  createdAt      DateTime  @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("service_order_photos")
}

model ServiceOrderStatusHistory {
  id             String             @id @default(cuid())
  serviceOrderId String
  fromStatus     ServiceOrderStatus?
  toStatus       ServiceOrderStatus
  changedById    String?
  notes          String?
  createdAt      DateTime           @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([createdAt])
  @@map("service_order_status_history")
}

// ─────────────────────────────────────────────
// Tires Catalog + Inventory
// ─────────────────────────────────────────────

model Tire {
  id            String   @id @default(cuid())
  tenantId      String
  brand         String
  model         String
  size          String   // e.g. 205/55R16
  width         Int?     // 205
  aspectRatio   Int?     // 55
  rimDiameter   Int?     // 16
  loadIndex     String?
  speedRating   String?
  type          TireType @default(PASSEIO)
  season        String?  // verao, inverno, all-season
  price         Decimal  @db.Decimal(12, 2)
  promoPrice    Decimal? @db.Decimal(12, 2)
  isPromo       Boolean  @default(false)
  stockQty      Int      @default(0)
  minStock      Int      @default(2)
  sku           String?
  description   String?
  imageUrl      String?
  compatibleMakes String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parts  ServiceOrderPart[]

  @@index([tenantId])
  @@index([tenantId, brand])
  @@index([tenantId, size])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([tenantId, price])
  @@map("tires")
}

// ─────────────────────────────────────────────
// Maintenance
// ─────────────────────────────────────────────

model MaintenanceType {
  id            String                  @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  defaultKm     Int?
  defaultDays   Int?
  intervalType  MaintenanceIntervalType @default(AMBOS)
  isSystem      Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  icon          String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plans  MaintenancePlan[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("maintenance_types")
}

model MaintenancePlan {
  id                String    @id @default(cuid())
  tenantId          String
  vehicleId         String
  maintenanceTypeId String
  lastServiceAt     DateTime?
  lastServiceKm     Int?
  nextDueAt         DateTime?
  nextDueKm         Int?
  intervalKm        Int?
  intervalDays      Int?
  notes             String?
  isActive          Boolean   @default(true)
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceType  MaintenanceType @relation(fields: [maintenanceTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([vehicleId])
  @@index([tenantId, nextDueAt])
  @@index([tenantId, nextDueKm])
  @@map("maintenance_plans")
}

// ─────────────────────────────────────────────
// Chat (Cliente ↔ Mecânico) — Realtime
// ─────────────────────────────────────────────

model ChatConversation {
  id             String   @id @default(cuid())
  tenantId       String
  serviceOrderId String   @unique
  clientId       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([tenantId])
  @@index([clientId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderUserId   String?          // null = cliente (via link público ou WhatsApp)
  senderName     String
  isFromClient   Boolean          @default(false)
  content        String?
  imageUrl       String?
  channel        MessageChannel   @default(APP_CHAT)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?            @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────
// WhatsApp Templates + Logs
// ─────────────────────────────────────────────

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  key       String   // e.g. os_status_change, appointment_reminder
  name      String
  body      String   // supports {{variaveis}}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("whatsapp_templates")
}

model WhatsAppMessageLog {
  id           String                @id @default(cuid())
  tenantId     String
  toPhone      String
  templateKey  String?
  body         String
  status       WhatsAppMessageStatus @default(PENDING)
  externalId   String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, toPhone])
  @@index([tenantId, createdAt])
  @@map("whatsapp_message_logs")
}

// ─────────────────────────────────────────────
// AI Agent Conversations
// ─────────────────────────────────────────────

model AiConversation {
  id           String   @id @default(cuid())
  tenantId     String
  phone        String
  clientName   String?
  isActive     Boolean  @default(true)
  context      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  content        String
  functionCalls  Json?
  tokensUsed     Int?
  createdAt      DateTime         @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
